rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HACKATHON RULES: any signed-in user (the app signs everyone in anonymously).
    // Before real use: separate counsellor logins with roles, and let prospects
    // read/write only their own lead.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
