# Copy this file to ".env" (same folder) and fill in the values.
# Never share .env or commit it to GitHub.

# Gemini API key from https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=paste-your-key-here

# Model name. Check the models available to your key in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- WhatsApp Cloud API (optional; leave empty until you set it up) ----
# From developers.facebook.com > your app > WhatsApp > API Setup
WA_TOKEN=
WA_PHONE_ID=
# Any secret word you choose; type the same word in Meta's webhook settings
WA_VERIFY_TOKEN=leaddesk-verify-123
WA_GRAPH_VERSION=v23.0
