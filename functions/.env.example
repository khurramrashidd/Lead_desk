# TEMPLATE ONLY (this file IS committed to GitHub).
# Copy it to ".env" in this same folder and put the real values there:
#   copy functions\.env.example functions\.env
# Never put a real key in THIS file.

# Gemini API key from https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=paste-your-key-here

# Main model, and a backup used if the main one is unavailable or out of free quota.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Staff emails that become admin automatically (comma-separated).
# If empty, the FIRST person to sign in on the desk becomes admin.
ADMIN_EMAILS=

# ---- WhatsApp Cloud API (optional; see docs/WHATSAPP_SETUP.md) ----
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=leaddesk-verify-123
WA_GRAPH_VERSION=v23.0
