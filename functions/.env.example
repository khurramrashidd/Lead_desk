# TEMPLATE ONLY (this file IS committed to GitHub).
# Copy it to ".env" in this same folder and put the real values there:
#   copy functions\.env.example functions\.env
# Never put a real key in THIS file. Every value here can ALSO be set later from
# Admin → AI engine / Admin → Channels without redeploying.

# ---- AI (free keys) -------------------------------------------------------------
# Gemini: https://aistudio.google.com → Get API key. Several keys: separate with commas.
# Live models (Oct 2026): gemini-3.6-flash (fast, default), gemini-3.8-flash (newest),
# gemini-3.5-flash-lite (cheapest). Old names (gemini-3.5-flash, gemini-2.0-flash…) are
# mapped to a live model automatically.
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq (free fallback + Whisper speech-to-text): https://console.groq.com/keys
# llama-3.3-70b-versatile was shut down for free accounts on 16 Aug 2026 → openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# OpenRouter (free fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---- Staff ----------------------------------------------------------------------
# Emails that become admin automatically (comma-separated).
# If empty, the FIRST person to sign in on the desk becomes admin.
ADMIN_EMAILS=

# ---- Channels (optional here; easier in Admin → Channels) ------------------------
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=leaddesk-verify-123
WA_GRAPH_VERSION=v23.0
TELEGRAM_BOT_TOKEN=
IG_TOKEN=
IG_USER_ID=
INTAKE_SECRET=leaddesk-intake-123
# Ask who / name / contact / course before counselling (also a switch in Admin → Channels).
ONBOARDING=on
CALENDAR_ID=

# ---- Advanced ----------------------------------------------------------------------
# Firestore triggers must run where the database is. Only set this if Admin → Channels →
# Diagnose says the database is not in asia-south1 (nam5 → us-central1, eur3 → europe-west1).
# TRIGGER_REGION=asia-south1
